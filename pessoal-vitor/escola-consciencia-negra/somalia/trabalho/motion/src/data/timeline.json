 "legendas": [
  {
   "t0": 5.1,
   "t1": 6.97,
   "txt": "Quando você pensa em África,"
  },
  {
   "t0": 7.04,
   "t1": 8.49,
   "txt": "o que vem à cabeça?"
  },
  {
   "t0": 8.88,
   "t1": 9.49,
   "txt": "Fome?"
  },
  {
   "t0": 9.56,
   "t1": 10.29,
   "txt": "Guerra?"
  },
  {
   "t0": 10.36,
   "t1": 12.13,
   "txt": "A África não é um país."
  },
  {
   "t0": 12.55,
   "t1": 16.35,
   "txt": "São 54 países com mais de mil línguas."
  },
  {
   "t0": 21.86,
   "t1": 24.669999999999998,
   "txt": "No Chifre da África, de frente para o"
  },
  {
   "t0": 24.74,
   "t1": 26.77,
   "txt": "oceano Índico, fica um deles,"
  },
  {
   "t0": 26.84,
   "t1": 28.05,
   "txt": "a Somália."
  },
  {
   "t0": 28.12,
   "t1": 31.03,
   "txt": "Na bandeira, uma estrela de cinco pontas."
  },
  {
   "t0": 31.1,
   "t1": 34.29,
   "txt": "Cada uma é uma terra do povo somali."
  },
  {
   "t0": 35.24,
   "t1": 37.91,
   "txt": "São 19 milhões de pessoas,"
  },
  {
   "t0": 37.98,
   "t1": 41.17,
   "txt": "um povo negro, de véus coloridos,"
  },
  {
   "t0": 41.24,
   "t1": 44.21,
   "txt": "uma só língua e fé muçulmana."
  },
  {
   "t0": 44.97,
   "t1": 47.94,
   "txt": "Muitos vivem como pastores de camelo."
  },
  {
   "t0": 50.09,
   "t1": 52.08,
   "txt": "É chamada de nação de poetas,"
  },
  {
   "t0": 52.15,
   "t1": 54.88,
   "txt": "tem praias brancas, mercados cheios e"
  },
  {
   "t0": 54.95,
   "t1": 57.16,
   "txt": "portos que negociam com a Arábia e a Índia"
  },
  {
   "t0": 57.23,
   "t1": 57.94,
   "txt": "há séculos."
  },
  {
   "t0": 59.0,
   "t1": 61.09,
   "txt": "Mas não é isso que chega até nós."
  },
  {
   "t0": 63.04,
   "t1": 65.27000000000001,
   "txt": "No fim do século dezenove,"
  },
  {
   "t0": 65.34,
   "t1": 68.17,
   "txt": "os europeus cortaram esse povo em pedaços."
  },
  {
   "t0": 68.24,
   "t1": 70.89,
   "txt": "Britânico, italiano, francês e dois que"
  },
  {
   "t0": 70.96,
   "t1": 73.29,
   "txt": "acabaram com a Etiópia e o Quênia."
  },
  {
   "t0": 73.36,
   "t1": 75.99,
   "txt": "São as cinco pontas daquela estrela."
  },
  {
   "t0": 77.29,
   "t1": 79.92,
   "txt": "Em 1960 veio a independência."
  },
  {
   "t0": 79.99,
   "t1": 84.30000000000001,
   "txt": "Em 1969, o ditador Siad Barre tomou o"
  },
  {
   "t0": 84.37,
   "t1": 84.76,
   "txt": "poder."
  },
  {
   "t0": 84.83,
   "t1": 87.42,
   "txt": "Na Guerra Fria, soviéticos e americanos"
  },
  {
   "t0": 87.49,
   "t1": 88.78,
   "txt": "encheram o país de armas."
  },
  {
   "t0": 89.41,
   "t1": 92.84,
   "txt": "Em 1991, a ditadura caiu e o Estado"
  },
  {
   "t0": 92.91,
   "t1": 94.12,
   "txt": "desmoronou junto."
  },
  {
   "t0": 95.82,
   "t1": 99.69000000000001,
   "txt": "Clãs disputaram cada rua e a fome de 1992"
  },
  {
   "t0": 99.76,
   "t1": 102.97000000000001,
   "txt": "matou centenas de milhares."
  },
  {
   "t0": 103.04,
   "t1": 106.01,
   "txt": "A ONU e os americanos vieram,"
  },
  {
   "t0": 106.08,
   "t1": 110.09,
   "txt": "mas em 1993 foram embora e o mundo"
  },
  {
   "t0": 110.16,
   "t1": 111.43,
   "txt": "desligou a câmera."
  },
  {
   "t0": 117.49,
   "t1": 119.88000000000001,
   "txt": "No vazio, cresceu o Al-Shabaab,"
  },
  {
   "t0": 119.95,
   "t1": 122.10000000000001,
   "txt": "um grupo extremista que usa a religião"
  },
  {
   "t0": 122.17,
   "t1": 123.14,
   "txt": "como uma arma."
  },
  {
   "t0": 123.21,
   "t1": 126.14,
   "txt": "Em 2017, um caminhão-bomba matou mais de"
  },
  {
   "t0": 126.21,
   "t1": 127.98,
   "txt": "500 pessoas na capital."
  },
  {
   "t0": 128.36,
   "t1": 130.69,
   "txt": "As maiores vítimas são os próprios"
  },
  {
   "t0": 130.76,
   "t1": 132.35,
   "txt": "muçulmanos somalis."
  },
  {
   "t0": 133.5,
   "t1": 137.31,
   "txt": "Dito tudo isso, só em 2012 voltou a"
  },
  {
   "t0": 137.38,
   "t1": 139.95000000000002,
   "txt": "existir um governo que ainda não controla"
  },
  {
   "t0": 140.02,
   "t1": 141.13,
   "txt": "o país inteiro."
  },
  {
   "t0": 141.2,
   "t1": 144.39000000000001,
   "txt": "No mar, barcos estrangeiros pescavam"
  },
  {
   "t0": 144.46,
   "t1": 148.21,
   "txt": "ilegalmente e parte dos pescadores virou"
  },
  {
   "t0": 148.28,
   "t1": 149.27,
   "txt": "pirata."
  },
  {
   "t0": 150.72,
   "t1": 151.67000000000002,
   "txt": "E tem a seca."
  },
  {
   "t0": 151.74,
   "t1": 155.21,
   "txt": "Em 2011, a fome matou mais de 250 mil"
  },
  {
   "t0": 155.28,
   "t1": 157.23,
   "txt": "pessoas, metade crianças."
  },
  {
   "t0": 157.54,
   "t1": 160.33,
   "txt": "Hoje, milhões vivem deslocados no próprio"
  },
  {
   "t0": 160.4,
   "t1": 161.03,
   "txt": "país."
  },
  {
   "t0": 162.18,
   "t1": 164.27,
   "txt": "Pensa numa mulher somali,"
  },
  {
   "t0": 164.34,
   "t1": 166.87,
   "txt": "ela anda quilômetros atrás de água com o"
  },
  {
   "t0": 166.94,
   "t1": 169.39000000000001,
   "txt": "filho no colo, enterra quem ama e,"
  },
  {
   "t0": 169.46,
   "t1": 171.27,
   "txt": "no outro dia, recomeça."
  },
  {
   "t0": 171.77,
   "t1": 174.61,
   "txt": "É dela que a Sade canta, uma mulher que"
  },
  {
   "t0": 174.68,
   "t1": 177.25,
   "txt": "junta grãos na estrada como quem junta"
  },
  {
   "t0": 177.32,
   "t1": 178.15,
   "txt": "pérolas."
  },
  {
   "t0": 191.15,
   "t1": 193.52,
   "txt": "A gente vê imagens e conclui,"
  },
  {
   "t0": 193.59,
   "t1": 196.54000000000002,
   "txt": "a África é assim, mas ninguém conta das"
  },
  {
   "t0": 196.61,
   "t1": 199.22,
   "txt": "fronteiras, das armas e das câmeras que"
  },
  {
   "t0": 199.29,
   "t1": 200.36,
   "txt": "vieram de fora."
  },
  {
   "t0": 201.71,
   "t1": 205.44,
   "txt": "Refugiados somalis sofrem xenofobia pelo"
  },
  {
   "t0": 205.51,
   "t1": 208.32,
   "txt": "mundo inteiro e dentro do país,"
  },
  {
   "t0": 208.39,
   "t1": 211.54000000000002,
   "txt": "os bantu somalis, muitos descendentes de"
  },
  {
   "t0": 211.61,
   "t1": 215.92000000000002,
   "txt": "escravizados, são discriminados a"
  },
  {
   "t0": 215.99,
   "t1": 216.8,
   "txt": "gerações."
  },
  {
   "t0": 222.6,
   "t1": 224.75,
   "txt": "Quando a África só aparece pela guerra e"
  },
  {
   "t0": 224.82,
   "t1": 226.81,
   "txt": "pela fome, a gente aprende a ver pessoas"
  },
  {
   "t0": 226.88,
   "t1": 229.57,
   "txt": "negras como problema, não como povo com"
  },
  {
   "t0": 229.64,
   "t1": 230.15,
   "txt": "história."
  },
  {
   "t0": 230.22,
   "t1": 233.21,
   "txt": "É o mesmo olhar que o racismo usa aqui no"
  },
  {
   "t0": 233.28,
   "t1": 233.81,
   "txt": "Brasil."
  },
  {
   "t0": 236.56,
   "t1": 239.85,
   "txt": "Da próxima vez que você pensar na África,"
  },
  {
   "t0": 239.92,
   "t1": 245.31,
   "txt": "lembra, são 54 países e cada um tem nome."
  },
  {
   "t0": 245.68,
   "t1": 248.12,
   "txt": "A Somália não é só guerra,"
  },
  {
