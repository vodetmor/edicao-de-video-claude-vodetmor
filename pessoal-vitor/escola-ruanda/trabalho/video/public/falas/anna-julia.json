 "frases": [
  {
   "a": 0.25,
   "b": 5.41,
   "t": "Olá, hoje vamos falar sobre\na Guerra Civil de Ruanda,"
  },
  {
   "a": 5.41,
   "b": 8.41,
   "t": "um conflito armado que devastou\num pequeno país na África"
  },
  {
   "a": 8.41,
   "b": 12.05,
   "t": "e culminou em uma das maiores\ntragédias humanitárias do século XX."
  },
  {
   "a": 12.75,
   "b": 16.17,
   "t": "A guerra foi uma disputa violenta\npor poder político e territorial"
  },
  {
   "a": 16.17,
   "b": 17.43,
   "t": "entre dois grandes grupos."
  },
  {
   "a": 17.43,
   "b": 20.81,
   "t": "De um lado, o governo\nde maioria hutu,"
  },
  {
   "a": 20.81,
   "b": 25.25,
   "t": "liderado pelo presidente Juvénal\nHabyarimana e apoiado pelas"
  },
  {
   "a": 25.25,
   "b": 27.95,
   "t": "forças armadas ruandesas\ne a milícia aliada."
  },
  {
   "a": 28.65,
   "b": 31.89,
   "t": "Do outro lado, a Frente\nPatriótica Ruandesa,"
  },
  {
   "a": 31.89,
   "b": 35.19,
   "t": "um movimento rebelde formado\nmajoritariamente por exilados"
  },
  {
   "a": 35.19,
   "b": 38.57,
   "t": "tutsis, liderado\nmilitarmente por Paul Kagame."
  }
 ]
}