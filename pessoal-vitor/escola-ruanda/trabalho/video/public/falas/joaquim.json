   "w": "história.",
   "a": 113.59,
   "b": 114.159
  }
 ],
 "frases": [
  {
   "a": 0.25,
   "b": 3.97,
   "t": "As consequências da guerra\ncivil e do genocídio de Ruanda"
  },
  {
   "a": 3.97,
   "b": 9.33,
   "t": "foram extremamente graves pelo\nlado da população e do Estado."
  },
  {
   "a": 9.33,
   "b": 13.33,
   "t": "Uma das principais consequências\npara a população foi a morte"
  },
  {
   "a": 13.33,
   "b": 17.89,
   "t": "de milhares de pessoas e\ncentenas de milhares de famílias"
  },
  {
   "a": 17.89,
   "b": 21.19,
   "t": "que foram destruídas\ne perderam suas casas."
  },
  {
   "a": 21.89,
   "b": 25.05,
   "t": "Milhões de ruandenses precisaram\nabandonar suas cidades"
  },
  {
   "a": 25.05,
   "b": 27.43,
   "t": "e buscar abrigo em outros países."
  },
  {
   "a": 27.43,
   "b": 33.17,
   "t": "O Estado também enfrentou\ngrandes dificuldades econômicas,"
  },
  {
   "a": 33.17,
   "b": 34.11,
   "t": "sociais e políticas."
  },
  {
   "a": 34.81,
   "b": 37.03,
   "t": "Com a queda da infraestrutura,"
  },
  {
   "a": 37.03,
   "b": 42.47,
   "t": "de hospitais, escolas e estruturas\nforam totalmente prejudicadas."
  },
  {
   "a": 43.29,
   "b": 48.41,
   "t": "A população precisou lidar com traumas e\ndificuldades para reconstruir suas vidas."
  },
  {
   "a": 49.11,
   "b": 52.85,
   "t": "Depois do conflito, foram\ncriados tribunais para julgar"
  },
  {
   "a": 52.85,
   "b": 54.17,
   "t": "os responsáveis pelo genocídio,"
  },
  {
   "a": 54.17,
   "b": 59.05,
   "t": "incluindo o Tribunal Penal\nInternacional para Ruanda,"
  },
  {
   "a": 59.05,
   "b": 61.63,
   "t": "estabelecido pela ONU em 1994."
  },
  {
   "a": 62.33,
   "b": 66.13,
   "t": "Também foram desenvolvidas\niniciativas de reconciliação"
  },
  {
   "a": 66.13,
   "b": 70.95,
   "t": "com os tribunais\ncomunitários Gacaca."
  },
  {
   "a": 71.65,
   "b": 75.83,
   "t": "Atualmente, o Estado se\nencontra de outra forma."
  },
  {
   "a": 75.83,
   "b": 78.95,
   "t": "A Ruanda é um país que passou\npor um importante processo"
  },
  {
   "a": 78.95,
   "b": 81.33,
   "t": "de reconstrução\ndepois dessa tragédia."
  },
  {
   "a": 81.33,
   "b": 84.49,
   "t": "O governo investiu\nna infraestrutura,"
  },
  {
   "a": 84.49,
   "b": 88.57,
   "t": "na educação, na saúde e no\ndesenvolvimento econômico."
  },
  {
   "a": 88.57,
   "b": 92.35,
   "t": "Também foram criados memoriais\npara homenagear as vítimas"
  },
  {
   "a": 92.35,
   "b": 94.95,
   "t": "e preservar a\nmemória do genocídio."
  },
  {
   "a": 95.65,
   "b": 100.67,
   "t": "Um exemplo é o Memorial\ndo Genocídio de Kigali,"
  },
  {
   "a": 100.67,
   "b": 104.35,
   "t": "que recebe visitantes e ajuda a\nconscientizar as novas gerações"
  },
  {
   "a": 104.35,
   "b": 107.17,
   "t": "sobre o que aconteceu."
  },
  {
   "a": 107.87,
   "b": 112.87,
   "t": "Tudo isso para que esse evento\nnunca torne a acontecer e fique"
  },
  {
   "a": 112.87,
   "b": 114.159,
   "t": "marcado na história."
  }
 ]
}