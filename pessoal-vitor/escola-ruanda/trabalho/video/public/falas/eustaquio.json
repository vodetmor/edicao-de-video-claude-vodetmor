 "frases": [
  {
   "a": 0.25,
   "b": 5.77,
   "t": "O fim da Guerra Civil de Ruanda\nocorreu em julho de 1994,"
  },
  {
   "a": 5.77,
   "b": 10.11,
   "t": "definido pela vitória militar\nda Frente Patriótica Ruandesa,"
  },
  {
   "a": 10.11,
   "b": 13.07,
   "t": "grupo rebelde\nmajoritariamente tutsi,"
  },
  {
   "a": 13.07,
   "b": 14.69,
   "t": "liderado por Paul Kagame,"
  },
  {
   "a": 14.69,
   "b": 19.57,
   "t": "sobre as forças governamentais\nhutus e as milícias extremistas."
  },
  {
   "a": 20.35,
   "b": 24.21,
   "t": "Essa vitória encerrou tanto o\nconflito armado quanto o genocídio"
  },
  {
   "a": 24.21,
   "b": 28.59,
   "t": "de Ruanda, que durou cerca de\n100 dias e deixou aproximadamente"
  },
  {
   "a": 28.59,
   "b": 30.37,
   "t": "800 mil mortos."
  }
