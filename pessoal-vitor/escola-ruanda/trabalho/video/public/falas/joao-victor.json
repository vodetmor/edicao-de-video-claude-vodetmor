 "frases": [
  {
   "a": 0,
   "b": 2.72,
   "t": "Durante o genocídio de Ruanda,"
  },
  {
   "a": 2.72,
   "b": 6.46,
   "t": "em 1994, a mídia teve um papel\nmuito importante na propagação"
  },
  {
   "a": 6.46,
   "b": 8.26,
   "t": "do ódio e da violência."
  },
  {
   "a": 8.26,
   "b": 12,
   "t": "Um dos principais\nexemplos foi a Rádio RTLM,"
  },
  {
   "a": 12,
   "b": 13.64,
   "t": "conhecida como Rádio Mil Colinas,"
  },
  {
   "a": 14.26,
   "b": 18.68,
   "t": "que transmitia mensagens\npreconceituosas contra os tutsis,"
  },
  {
   "a": 18.68,
   "b": 22.1,
   "t": "espalhando mentiras, incentivando\na discriminação e estimulando"
  },
  {
   "a": 22.1,
   "b": 24.66,
   "t": "a população hutu a\nparticipar dos assassinatos."
  },
  {
   "a": 24.66,
   "b": 28.68,
   "t": "A rádio chegou a divulgar\ninformações sobre onde as vítimas"
  },
  {
   "a": 28.68,
   "b": 32.44,
   "t": "estavam escondidas, facilitando\na organização e a perseguição"
  },
  {
