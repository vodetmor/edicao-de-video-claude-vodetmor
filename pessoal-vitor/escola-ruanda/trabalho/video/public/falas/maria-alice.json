 "frases": [
  {
   "a": 0,
   "b": 6.14,
   "t": "O clima de tensão atingiu o limite\nna noite 6 de abril de 1994,"
  },
  {
   "a": 6.14,
   "b": 8.52,
   "t": "quando o avião que trazia o\npresidente Juvénal Habyarimana"
  },
  {
   "a": 8.52,
   "b": 11.88,
   "t": "de volta de uma reunião de\npaz foi abatido por um míssil"
  },
  {
   "a": 11.88,
   "b": 14.02,
   "t": "ao se aproximar da capital,"
  },
  {
   "a": 14.02,
   "b": 15.92,
   "t": "Kigali, matando todos a bordo."
  },
  {
   "a": 15.92,
   "b": 18.98,
   "t": "Até hoje existe debate sobre\nquem disparou o míssil,"
  },
  {
   "a": 18.98,
   "b": 22.34,
   "t": "mas os extremistas hutus\nimediatamente culparam os rebeldes"
  },
  {
   "a": 22.34,
   "b": 24.98,
   "t": "da FPR. Naquela mesma noite,"
  },
  {
   "a": 24.98,
   "b": 27.68,
   "t": "o genocídio começou\nde forma organizada."
  },
  {
   "a": 27.68,
   "b": 31.22,
   "t": "As forças armadas e milícias\nextremistas conhecidas como"
  },
  {
   "a": 31.22,
   "b": 35.6,
   "t": "Interahamwe montaram bloqueios\nnas ruas e iniciaram uma caçada"
  },
  {
   "a": 35.6,
   "b": 40.6,
   "t": "sistemática. O objetivo não\nera apenas vencer uma guerra,"
  },
  {
   "a": 40.6,
   "b": 44.5,
   "t": "mas exterminar toda a\npopulação tutsi do país,"
  },
  {
   "a": 44.5,
   "b": 46.76,
   "t": "além de qualquer hutu moderado"
  },
  {
   "a": 46.76,
   "b": 49.34,
   "t": "que tentasse protegê-los\nou defendesse a paz."
  },
  {
   "a": 50.18,
   "b": 54,
   "t": "O que torna esse genocídio ainda\nmais chocante é sua velocidade"
  },
  {
   "a": 54,
   "b": 57.86,
