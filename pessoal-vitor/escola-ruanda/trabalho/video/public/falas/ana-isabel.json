 "frases": [
  {
   "a": 0.25,
   "b": 7.29,
   "t": "Em outubro de 1990, a FPR\ninvadiu o norte de Ruanda,"
  },
  {
   "a": 7.29,
   "b": 9.51,
   "t": "dando início oficial\nà Guerra Civil,"
  },
  {
   "a": 9.51,
   "b": 13.11,
   "t": "contra o governo do presidente\nhutu Juvénal Habyarimana."
  },
  {
   "a": 13.11,
   "b": 17.55,
   "t": "Durante três anos, o país\nviveu em conflito armado,"
  },
  {
   "a": 17.55,
   "b": 20.69,
   "t": "o que gerou uma grave crise\neconômica e aumentou o medo"
  },
  {
   "a": 20.69,
   "b": 23.03,
   "t": "e a desconfiança\ndentro da população."
  },
  {
   "a": 23.73,
   "b": 27.28,
   "t": "O governo passou a tratar os\ntutsis que ainda viviam dentro"
  },
  {
   "a": 27.28,
   "b": 29.8,
   "t": "de Ruanda como\ncúmplices dos rebeldes."
  },
  {
   "a": 29.8,
   "b": 35.94,
   "t": "Em agosto de 1993, sob\nforte pressão internacional,"
  },
  {
   "a": 35.94,
   "b": 41.18,
   "t": "o governo e a FPR assinaram\nos Acordos de Arusha,"
  },
  {
   "a": 41.18,
   "b": 42.68,
   "t": "na Tanzânia."
  },
  {
   "a": 43.38,
   "b": 45.76,
   "t": "O tratado previa um cessa-fogo,"
  },
  {
   "a": 45.76,
   "b": 49.28,
   "t": "o retorno dos refugiados e a\ndivisão do poder político entre"
  },
  {
   "a": 49.28,
   "b": 54.4,
   "t": "hutus e tutsis. Porém, esse\nacordo enfureceu os hutus mais"
  },
  {
   "a": 54.4,
   "b": 56.82,
   "t": "radicais dentro do\npróprio governo,"
  },
  {
   "a": 56.82,
   "b": 60.56,
   "t": "que não aceitavam dividir\no poder de forma alguma."
  },
  {
   "a": 61.26,
   "b": 63.48,
   "t": "Enquanto a paz era\nassinada no papel,"
  },
  {
   "a": 64.18,
   "b": 67.92,
   "t": "esses extremistas começaram a\nimportar armas em segredo e treinar"
  },
  {
   "a": 67.92,
   "b": 70.1,
   "t": "milícias civis para\nalgo muito pior."
  }
 ]
}